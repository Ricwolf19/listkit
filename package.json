{
	"name": "listkit-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo root for @pibytelabs/listkit",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ricwolf19/listkit.git"
	},
	"license": "MIT",
	"author": "Ricwolf19 <rhtc19@gmail.com>",
	"packageManager": "pnpm@11.4.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter playground dev",
		"build": "pnpm --filter @pibytelabs/listkit build",
		"build:all": "pnpm -r build",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@eslint/js": "^9.39.4",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"prettier": "^3.8.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.0"
	}
}
