{
	"name": "listkit-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo root for @pibytelabs/listkit",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ricwolf19/listkit.git"
	},
	"license": "MIT",
	"author": "Ricwolf19 <rhtc19@gmail.com>",
	"packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --parallel --filter @pibytelabs/listkit --filter playground run dev",
		"dev:playground": "pnpm --filter playground dev",
		"dev:package": "pnpm --filter @pibytelabs/listkit dev",
		"build": "pnpm --filter @pibytelabs/listkit build",
		"build:all": "pnpm -r build",
		"docs": "pnpm --filter @pibytelabs/listkit run docs",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"verify": "pnpm lint && pnpm build && pnpm typecheck",
		"verify:full": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm knip && pnpm depcruise && pnpm --filter @pibytelabs/listkit size && pnpm --filter @pibytelabs/listkit check:publish && pnpm --filter @pibytelabs/listkit check:types",
		"verify:ci": "pnpm lint && pnpm exec secretlint --secretlintignore .gitignore \"**/*\" && pnpm build && pnpm typecheck && pnpm knip && pnpm depcruise && pnpm --filter @pibytelabs/listkit size && pnpm --filter @pibytelabs/listkit check:publish && pnpm --filter @pibytelabs/listkit check:types",
		"fix": "pnpm format && pnpm lint --fix && pnpm knip:fix",
		"knip": "knip",
		"knip:fix": "knip --fix",
		"depcruise": "depcruise --config .dependency-cruiser.cjs packages/listkit/src playground/src",
		"depcruise:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot packages/listkit/src | dot -T svg > dependency-graph.svg",
		"changeset": "changeset",
		"release:prepare": "pnpm exec changeset version && git add . && git diff --staged --quiet || git commit -m \"chore: release\"",
		"version": "changeset version",
		"release": "changeset publish",
		"prepare": "husky && chmod +x .husky/pre-commit .husky/pre-push 2>/dev/null || true"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@commitlint/types": "^21.0.1",
		"@eslint/js": "^9.39.4",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
		"@size-limit/preset-small-lib": "^12.1.0",
		"dependency-cruiser": "^17.4.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-jsdoc": "^63.0.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"knip": "^6.14.2",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"secretlint": "^13.0.2",
		"size-limit": "^12.1.0",
		"typedoc": "^0.28.19",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.0"
	}
}
