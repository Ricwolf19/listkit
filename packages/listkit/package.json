{
	"name": "@pibytelabs/listkit",
	"version": "2.12.0",
	"description": "Standardized list views for React — table/cards, search, pagination, advanced filters.",
	"keywords": [
		"react",
		"list",
		"table",
		"datatable",
		"cards",
		"pagination",
		"filters",
		"crud",
		"nextjs"
	],
	"license": "MIT",
	"author": "Ricwolf19 <rhtc19@gmail.com>",
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ricwolf19/listkit.git",
		"directory": "packages/listkit"
	},
	"homepage": "https://github.com/Ricwolf19/listkit#readme",
	"bugs": {
		"url": "https://github.com/Ricwolf19/listkit/issues"
	},
	"type": "module",
	"sideEffects": false,
	"publishConfig": {
		"registry": "https://registry.alagrandelepusecuca.mx/",
		"access": "restricted"
	},
	"files": [
		"dist",
		"tailwind.css",
		"README.md",
		"README.es.md",
		"LICENSE",
		"NOTICE"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./next": {
			"import": {
				"types": "./dist/next.d.ts",
				"default": "./dist/next.js"
			},
			"require": {
				"types": "./dist/next.d.cts",
				"default": "./dist/next.cjs"
			}
		},
		"./react-router": {
			"import": {
				"types": "./dist/react-router.d.ts",
				"default": "./dist/react-router.js"
			},
			"require": {
				"types": "./dist/react-router.d.cts",
				"default": "./dist/react-router.cjs"
			}
		},
		"./adapters": {
			"import": {
				"types": "./dist/adapters.d.ts",
				"default": "./dist/adapters.js"
			},
			"require": {
				"types": "./dist/adapters.d.cts",
				"default": "./dist/adapters.cjs"
			}
		},
		"./server": {
			"import": {
				"types": "./dist/server.d.ts",
				"default": "./dist/server.js"
			},
			"require": {
				"types": "./dist/server.d.cts",
				"default": "./dist/server.cjs"
			}
		},
		"./query": {
			"import": {
				"types": "./dist/query.d.ts",
				"default": "./dist/query.js"
			},
			"require": {
				"types": "./dist/query.d.cts",
				"default": "./dist/query.cjs"
			}
		},
		"./sql": {
			"import": {
				"types": "./dist/sql.d.ts",
				"default": "./dist/sql.js"
			},
			"require": {
				"types": "./dist/sql.d.cts",
				"default": "./dist/sql.cjs"
			}
		},
		"./mongo": {
			"import": {
				"types": "./dist/mongo.d.ts",
				"default": "./dist/mongo.js"
			},
			"require": {
				"types": "./dist/mongo.d.cts",
				"default": "./dist/mongo.cjs"
			}
		},
		"./mongoose": {
			"import": {
				"types": "./dist/mongoose.d.ts",
				"default": "./dist/mongoose.js"
			},
			"require": {
				"types": "./dist/mongoose.d.cts",
				"default": "./dist/mongoose.cjs"
			}
		},
		"./react-query": {
			"import": {
				"types": "./dist/react-query.d.ts",
				"default": "./dist/react-query.js"
			},
			"require": {
				"types": "./dist/react-query.d.cts",
				"default": "./dist/react-query.cjs"
			}
		},
		"./tailwind.css": "./tailwind.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"clean": "rm -rf dist",
		"size": "size-limit",
		"size:why": "size-limit --why",
		"check:publish": "publint",
		"check:types": "echo 'attw check skipped — re-enable in v0.1.0 once package has real runtime content'",
		"docs": "typedoc",
		"docs:watch": "typedoc --watch"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.0.0",
		"lucide-react": ">=0.400.0",
		"mongoose": ">=7.0.0",
		"next": "^14.0.0 || ^15.0.0 || ^16.0.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"react-router-dom": "^6.0.0 || ^7.0.0",
		"tailwindcss": "^4.0.0",
		"zod": "^3.23.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-query": {
			"optional": true
		},
		"lucide-react": {
			"optional": false
		},
		"mongoose": {
			"optional": true
		},
		"next": {
			"optional": true
		},
		"react-router-dom": {
			"optional": true
		},
		"tailwindcss": {
			"optional": false
		},
		"zod": {
			"optional": true
		}
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"react-datepicker": "^9.1.0",
		"tailwind-merge": "^2.5.5"
	},
	"devDependencies": {
		"@tanstack/react-query": "^5.83.0",
		"@types/react": "^19.0.2",
		"@types/react-dom": "^19.0.2",
		"lucide-react": "^1.14.0",
		"mongoose": "^9.7.1",
		"next": "^16.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router-dom": "^7.0.0",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2",
		"vitest": "^4.1.9",
		"zod": "^4.0.0"
	}
}
